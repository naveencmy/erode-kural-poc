# =================================================================
# Erode Collectorate AI System — Environment Configuration (.env)
# =================================================================

# Server & Mode
PORT=8000
DEV_MODE=True

# Database & Storage
DATABASE_PATH=collectorate_workflow.db

# Ollama LLM Configuration
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SEC=15

# ---------------------------------------------------------------------------
# Gmail Configuration (naveenatdevine@gmail.com)
# ---------------------------------------------------------------------------
# ⚠️ Gmail requires an App Password (not your regular password).
#    Generate at: https://myaccount.google.com/apppasswords
#    1. Enable 2-Step Verification on your Google Account
#    2. Go to App Passwords → Select "Mail" → Generate
#    3. Paste the 16-char password below (no spaces)

# IMAP Inbound (Receiving Petitions)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=naveenatdevine@gmail.com
IMAP_PASSWORD=your_gmail_app_password_here

# SMTP Outbound (Sending Acknowledgements)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=naveenatdevine@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=naveenatdevine@gmail.com
SMTP_FROM_NAME="ஈரோடு மாவட்ட ஆட்சியரகம் (Erode Collectorate)"

# ---------------------------------------------------------------------------
# Mailpit Local Testing (Optional — use instead of Gmail for dev)
# ---------------------------------------------------------------------------
# Run: tools\mailpit.exe     (or: docker run -d -p 8025:8025 -p 1025:1025 axllent/mailpit)
# Web UI: http://localhost:8025
#
# Uncomment below to route all mail through Mailpit:
# SMTP_SERVER=127.0.0.1
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false
# IMAP_SERVER=127.0.0.1
# IMAP_PORT=1143
# IMAP_USERNAME=
# IMAP_PASSWORD=
