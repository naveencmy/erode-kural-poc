# =================================================================
# Erode Collectorate AI System - Environment Configuration (.env)
# =================================================================

# Server & Mode
PORT=8000
DEV_MODE=True

# Database & Storage
DATABASE_PATH=collectorate_workflow.db

# Ollama LLM Configuration
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SEC=15

# Mailpit Local Development Mailbox Configuration
# Run Mailpit: docker run -d -p 8025:8025 -p 1025:1025 axllent/mailpit
SMTP_SERVER=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=collectorate.erode@tn.gov.in
SMTP_FROM_NAME="ஈரோடு மாவட்ட ஆட்சியரகம் (Erode Collectorate)"
MAILPIT_WEB_URL=http://localhost:8025

# Production SMTP (Uncomment & configure for Live NIC/Gmail)
# SMTP_SERVER=smtp.nic.in
# SMTP_PORT=587
# SMTP_USERNAME=collectorate.erode@tn.gov.in
# SMTP_PASSWORD=your_secure_password
# SMTP_USE_TLS=true

# IMAP Inbound Petitions
IMAP_SERVER=imap.nic.in
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
